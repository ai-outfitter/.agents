{
  "settings": {
    "directTools": false,
    "elicitation": false,
    "outputGuard": true,
    "sampling": false
  },
  "mcpServers": {
    "github": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,issues,pull_requests,repos"
      },
      "lifecycle": "keep-alive",
      "requestTimeoutMs": 30000
    },
    "github-write": {
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Toolsets": "context,issues,pull_requests,repos"
      },
      "lifecycle": "keep-alive",
      "requestTimeoutMs": 30000
    }
  }
}
